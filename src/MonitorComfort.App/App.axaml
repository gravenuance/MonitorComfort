<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MonitorComfort.App.App"
             RequestedThemeVariant="Default">

  <!-- Resources come first: the styles below look their tokens up as static resources. -->
  <Application.Resources>
    <ResourceDictionary>
      <Thickness x:Key="CardPadding">16</Thickness>
      <Thickness x:Key="CardMargin">0,0,0,12</Thickness>
      <Thickness x:Key="PagePadding">16</Thickness>
      <CornerRadius x:Key="CardRadius">8</CornerRadius>
      <x:Double x:Key="RowSpacing">8</x:Double>
      <x:Double x:Key="ColumnSpacing">12</x:Double>
      <x:Double x:Key="SectionFontSize">15</x:Double>
      <x:Double x:Key="StatusFontSize">18</x:Double>

      <ResourceDictionary.ThemeDictionaries>
        <!-- Checked for WCAG AA: text ≥ 6.8:1 and card borders ≥ 3:1 against the card colour. -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#8A939B" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#4A5560" />
          <SolidColorBrush x:Key="AttentionTextBrush" Color="#8A4B00" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C242A" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#6B7680" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#B7C0C7" />
          <SolidColorBrush x:Key="AttentionTextBrush" Color="#F0B060" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Padding" Value="{StaticResource CardPadding}" />
      <Setter Property="Margin" Value="{StaticResource CardMargin}" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{StaticResource SectionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="{StaticResource StatusFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status.attention">
      <Setter Property="Foreground" Value="{DynamicResource AttentionTextBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>

</Application>
