<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MonitorComfort.App.App"
             RequestedThemeVariant="Default">

  <!-- Resources come first: the styles below look their tokens up as static resources. -->
  <Application.Resources>
    <ResourceDictionary>
      <Thickness x:Key="CardPadding">14,12</Thickness>
      <Thickness x:Key="CardMargin">0,0,0,10</Thickness>
      <Thickness x:Key="PagePadding">14,10</Thickness>
      <CornerRadius x:Key="CardRadius">8</CornerRadius>
      <x:Double x:Key="RowSpacing">8</x:Double>
      <x:Double x:Key="ColumnSpacing">12</x:Double>
      <x:Double x:Key="TitleBarHeight">36</x:Double>
      <x:Double x:Key="CloseButtonWidth">46</x:Double>
      <x:Double x:Key="CloseGlyphSize">10</x:Double>
      <x:Double x:Key="NavWidth">168</x:Double>
      <x:Double x:Key="NavItemHeight">36</x:Double>
      <x:Double x:Key="NavGlyphSize">16</x:Double>
      <x:Double x:Key="NavGlyphWidth">20</x:Double>
      <CornerRadius x:Key="NavItemRadius">6</CornerRadius>
      <x:Double x:Key="BodyFontSize">13</x:Double>
      <x:Double x:Key="CaptionFontSize">11</x:Double>
      <x:Double x:Key="HintFontSize">12</x:Double>
      <x:Double x:Key="StatusDotSize">8</x:Double>
      <x:Double x:Key="SwatchSize">14</x:Double>
      <x:Double x:Key="ValueColumnWidth">60</x:Double>
      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="ValueFont">Cascadia Mono, Consolas</FontFamily>
      <!-- Same code points in both fonts; Segoe Fluent Icons ships with Windows 11. -->
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <!-- Navigation entry: no Fluent template, so the marker, fill and focus ring are ours and share the tokens. -->
      <ControlTheme x:Key="NavItemTheme" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource NavItemHeight}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Root" MinHeight="{TemplateBinding MinHeight}" CornerRadius="{StaticResource NavItemRadius}"
                    BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
              <Grid ColumnDefinitions="Auto,*">
                <Border Name="PART_Marker" Width="3" Height="16" Margin="3,0,0,0" CornerRadius="2"
                        VerticalAlignment="Center" Background="Transparent" />
                <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Padding="8,0" VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Root">
          <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Root">
          <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Marker">
          <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Root">
          <Setter Property="Background" Value="{DynamicResource NavPressedBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
        </Style>
      </ControlTheme>

      <!-- Instrument-panel identity: amber accent on graphite, with a warm-paper light variant.
           Checked for WCAG AA against the card colour: text ≥ 4.5:1, accent text ≥ 5:1, input borders ≥ 3:1.
           Navigation sits on NavBackground (the title bar colour); hover, selected and pressed are ink or accent mixed into it
           at 7%, 14-16% and 12%. Ink on every state ≥ 10.6:1 in both themes; the accent marker and focus ring on the nav
           background and on the selected fill are ≥ 4.4:1 and ≥ 3.7:1 in light, ≥ 8.1:1 and ≥ 6.1:1 in dark (needs 3:1).
           Close glyph: white on CloseHover 5.7:1 and on ClosePressed 7.6:1 in both themes; CloseHover against the dark
           title bar is 3.1:1, against the light one 4.6:1. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F1EC" />
          <SolidColorBrush x:Key="TitleBarBrush" Color="#ECE8E1" />
          <SolidColorBrush x:Key="NavBackgroundBrush" Color="#ECE8E1" />
          <SolidColorBrush x:Key="NavHoverBrush" Color="#DDDAD4" />
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#E1D4C2" />
          <SolidColorBrush x:Key="NavPressedBrush" Color="#D3D0CA" />
          <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="ClosePressedBrush" Color="#A1220F" />
          <SolidColorBrush x:Key="CloseHoverGlyphBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#D9D3C9" />
          <SolidColorBrush x:Key="InputBorderBrush" Color="#8A8478" />
          <SolidColorBrush x:Key="InkBrush" Color="#1C1E22" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#5A6270" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#9A5B00" />
          <SolidColorBrush x:Key="GoodBrush" Color="#2E7D55" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackgroundBrush" Color="#14161A" />
          <SolidColorBrush x:Key="TitleBarBrush" Color="#17191E" />
          <SolidColorBrush x:Key="NavBackgroundBrush" Color="#17191E" />
          <SolidColorBrush x:Key="NavHoverBrush" Color="#26282C" />
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#382F23" />
          <SolidColorBrush x:Key="NavPressedBrush" Color="#303237" />
          <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="ClosePressedBrush" Color="#A1220F" />
          <SolidColorBrush x:Key="CloseHoverGlyphBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B1E24" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#2C3038" />
          <SolidColorBrush x:Key="InputBorderBrush" Color="#6B7280" />
          <SolidColorBrush x:Key="InkBrush" Color="#E8EAED" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#868FA0" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#E8A33D" />
          <SolidColorBrush x:Key="GoodBrush" Color="#5FB88A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#9A5B00" RegionColor="#F4F1EC" />
        <ColorPaletteResources x:Key="Dark" Accent="#E8A33D" RegionColor="#14161A" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
      <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style Selector="Border.titlebar">
      <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
      <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="TextBlock.glyph">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="{StaticResource CloseGlyphSize}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Width" Value="{StaticResource CloseButtonWidth}" />
      <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CloseHoverGlyphBrush}" />
    </Style>
    <Style Selector="Button.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ClosePressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CloseHoverGlyphBrush}" />
    </Style>
    <Style Selector="Button.close:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.nav">
      <Setter Property="Width" Value="{StaticResource NavWidth}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="{DynamicResource NavBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.navglyph">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="{StaticResource NavGlyphSize}" />
      <Setter Property="Width" Value="{StaticResource NavGlyphWidth}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.navtitle">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="{StaticResource PagePadding}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Padding" Value="{StaticResource CardPadding}" />
      <Setter Property="Margin" Value="{StaticResource CardMargin}" />
      <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Status dot: grey while starting or paused, green while adjusting, amber when it needs the user. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="{StaticResource StatusDotSize}" />
      <Setter Property="Height" Value="{StaticResource StatusDotSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.active">
      <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.attention">
      <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="{StaticResource SwatchSize}" />
      <Setter Property="Height" Value="{StaticResource SwatchSize}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section caption: small, upper-case and muted, so the setting titles carry the weight. -->
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFamily" Value="{StaticResource ValueFont}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status.attention">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{StaticResource HintFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Fluent's input borders are too faint on the graphite cards for 3:1. -->
    <Style Selector="NumericUpDown, ComboBox, TimePicker, TextBox">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    </Style>
  </Application.Styles>

</Application>
